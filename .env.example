# --- Database (dev: docker-compose reads these to create the container) ---
DB_NAME=ticketflow
DB_USER=ticketflow
DB_PASSWORD=changeme

# --- Database (prod only: full JDBC URL, no default in application-prod.yml) ---
# DB_URL=jdbc:postgresql://your-db-host:5432/ticketflow

# --- Security ---
# HS256 signing key — must be at least 32 characters. Generate a random one:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# --- Optional ---
# SPRING_PROFILES_ACTIVE=dev
